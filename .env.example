# Copy to .env (or export in your shell) and fill in whichever providers you use.
# golduck reads these at startup; at least one is required unless you're running
# the cxr Bedrock proxy locally.

# Anthropic (Claude) — required if not using a local proxy.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT / o1 / o3 / o4).
# OPENAI_API_KEY=sk-...

# Google Gemini.
# GEMINI_API_KEY=AIza...

# Zhipu GLM.
# ZHIPUAI_API_KEY=...

# DeepSeek.
# DEEPSEEK_API_KEY=sk-...

# xAI / Grok.
# XAI_API_KEY=xai-...

# Mistral.
# MISTRAL_API_KEY=...

# Groq.
# GROQ_API_KEY=gsk_...

# OpenRouter (aggregator).
# OPENROUTER_API_KEY=sk-or-...

# Custom OpenAI-compatible endpoint (e.g. self-hosted vLLM / Ollama).
# GOLDUCK_CUSTOM_BASE_URL=http://localhost:11434/v1
# GOLDUCK_CUSTOM_API_KEY=ignored
# GOLDUCK_CUSTOM_MODEL=llama3.1:70b

# Pick a default model — any slug from /providers works.
# GOLDUCK_MODEL=claude-opus-4-7
